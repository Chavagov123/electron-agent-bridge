{
  "name": "@eab/mcp",
  "version": "1.1.0-rc.0",
  "description": "MCP server (eab-mcp) and CLI (eab) on top of @eab/client.",
  "license": "MIT",
  "author": "electron-agent-bridge contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chavagov123/electron-agent-bridge.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Chavagov123/electron-agent-bridge#readme",
  "bugs": "https://github.com/Chavagov123/electron-agent-bridge/issues",
  "keywords": [
    "electron",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "automation",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "@eab/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --esm-only --bin src/bin/eab-mcp.ts --bin src/bin/eab.ts src/index.ts",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@eab/attach": "workspace:*",
    "@eab/client": "workspace:*",
    "@eab/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "bin": {
    "eab": "dist/bin/eab.js",
    "eab-mcp": "dist/bin/eab-mcp.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
