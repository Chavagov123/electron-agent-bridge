{
  "name": "@eab/page-agent",
  "version": "1.1.0-rc.0",
  "description": "In-page agent (isolated world) and main-world state hook. Dependency-free; built to IIFE strings.",
  "license": "MIT",
  "author": "electron-agent-bridge contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chavagov123/electron-agent-bridge.git",
    "directory": "packages/page-agent"
  },
  "homepage": "https://github.com/Chavagov123/electron-agent-bridge#readme",
  "bugs": "https://github.com/Chavagov123/electron-agent-bridge/issues",
  "keywords": [
    "electron",
    "automation",
    "accessibility",
    "snapshot"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "@eab/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs src/index.ts",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@eab/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
