{
  "$comment": "Pinned open-source Electron apps for the OSS suite (e2e/specs/oss.e2e.ts). Each runs unmodified in Launch mode on the harness's Electron. Keep apps that work on Electron 35+ and whose build output runs on any Electron (no V8 bytecode). `electronBinary: true` lets the app's own Electron download (its build needs it); `setup` runs after install (the install scripts are skipped; Mattermost's native modules are built by its own install-app-deps step, with a node-gyp that knows Visual Studio 2026); `args` follow the app directory on the command line. Several apps need Node 24 for their tooling: run the suite under Node 24. `app` may be an app.asar and may use `${platform}` and `${arch}` (packager output folders).",
  "apps": [
    {
      "name": "electron-quick-start",
      "repo": "https://github.com/electron/electron-quick-start.git",
      "ref": "91a1d64abdeb31e7506d19434c46a3a541ffd3cb",
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "build": [],
      "app": ".",
      "ipc": false
    },
    {
      "name": "electron-react-boilerplate",
      "repo": "https://github.com/electron-react-boilerplate/electron-react-boilerplate.git",
      "ref": "e5b8242d8b21a4290c3a1f18ae3b64167e9de04a",
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "electronBinary": true,
      "build": ["npx", "electron-vite", "build"],
      "app": ".",
      "ipc": true
    },
    {
      "name": "jitsi-meet-electron",
      "repo": "https://github.com/jitsi/jitsi-meet-electron.git",
      "ref": "28c2dfde875faf554c5ea6fa97b09c7ea9180273",
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "setup": [["npx", "patch-package"]],
      "build": ["node", "esbuild.js"],
      "app": ".",
      "ipc": true
    },
    {
      "name": "mattermost-desktop",
      "repo": "https://github.com/mattermost/desktop.git",
      "ref": "6ef64444bb9763454527dbb50e4175f19f0820e1",
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "setup": [
        ["npx", "patch-package"],
        ["npm", "pkg", "set", "overrides.node-gyp=13.1.0"],
        ["npm", "install", "--ignore-scripts", "--no-audit", "--no-fund"],
        ["npx", "electron-builder", "install-app-deps"]
      ],
      "build": ["npm", "run", "build"],
      "app": "dist",
      "args": ["--disable-dev-mode"],
      "ipc": true
    },
    {
      "name": "ferdium",
      "repo": "https://github.com/ferdium/ferdium-app.git",
      "ref": "deabf8308f37cde7d9baba5729f90d885fab3341",
      "install": ["corepack", "pnpm", "install", "--frozen-lockfile", "--ignore-scripts"],
      "setup": [
        ["node", "scripts/prepare.js"],
        ["corepack", "pnpm", "exec", "preval-build-info-cli"]
      ],
      "build": ["node", "esbuild.mjs"],
      "app": "build",
      "ipc": true
    },
    {
      "name": "super-productivity",
      "repo": "https://github.com/johannesjo/super-productivity.git",
      "ref": "0c1adf6a6927e5780b76cde72b74d3c2b421ecff",
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "setup": [
        ["npx", "patch-package"],
        ["npx", "ts-patch", "install"],
        ["npm", "run", "sync-core:build"],
        ["npm", "run", "sync-providers:build"],
        ["npm", "run", "shared-schema:build"],
        ["npm", "run", "plugin-api:build"],
        ["npm", "run", "buildFrontend:prod:es6"]
      ],
      "build": ["npm", "run", "electron:build"],
      "app": ".",
      "ipc": true
    },
    {
      "name": "zettlr",
      "repo": "https://github.com/Zettlr/Zettlr.git",
      "ref": "e20591b794e857f64b875f7b2f8a7adc5d62c94a",
      "install": ["corepack", "yarn", "install", "--immutable"],
      "build": ["corepack", "yarn", "package"],
      "app": "out/Zettlr-${platform}-${arch}/resources/app.asar",
      "ipc": true
    }
  ]
}
